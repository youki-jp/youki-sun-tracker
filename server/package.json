{
  "name": "youki-sun-tracker-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "echo 'No build step required'",
    "dev": "bun --hot src/index.ts",
    "dev:test-users": "bun scripts/dev-test-users.ts",
    "migrate": "bun scripts/migrate.ts",
    "seed:test-users": "bun scripts/seed-test-users.ts",
    "migration:generate": "drizzle-kit generate",
    "backup": "bun scripts/backup.ts",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "start": "bun src/index.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "hono": "^4.12.9"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.11",
    "typescript": "5.9.3"
  }
}
